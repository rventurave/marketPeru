# Copiar este archivo a `.env` y completar con valores reales.
# NUNCA subir `.env` a Git (ya está excluido en .gitignore).
#
# Los valores aquí son solo plantillas de ejemplo; reemplazar antes de usar.

# ID de cuenta de Cloudflare (obtener con: wrangler whoami)
CLOUDFLARE_ACCOUNT_ID=

# ID de la base de datos D1 (obtener con: wrangler d1 create marketperu)
D1_DATABASE_ID=

# Nombre del bucket R2 (crear con: wrangler r2 bucket create marketperu-images)
R2_BUCKET_NAME=marketperu-images

# Secreto para firmar sesiones (generar con: openssl rand -base64 32)
SESSION_SECRET=

# Origen permitido para CORS en desarrollo
CORS_ORIGIN=http://localhost:8787
